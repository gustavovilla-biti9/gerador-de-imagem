# Copy to frontend/.env.local (and backend/.env for local Python runs) and fill in real values.
# Never commit a file with real values — only this template is tracked in git.

# --- Backend (Python / FastAPI) ---
# Replicate API token (https://replicate.com/account/api-tokens) — used to call google/nano-banana.
REPLICATE_API_TOKEN=

# Neon Postgres connection string, provisioned via `vercel integration add neon`.
DATABASE_URL=

# Upstash Redis REST credentials, provisioned via `vercel integration add upstash`. Used only for rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max image generations allowed per IP per minute (optional, defaults to 5).
RATE_LIMIT_PER_MINUTE=5

# --- Frontend (Next.js) ---
# Vercel Blob read/write token (enabled natively on the project, no Marketplace install needed).
BLOB_READ_WRITE_TOKEN=

# Shared password for the single admin user (no account system — just a gate).
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# BACKEND_URL is injected automatically by the Vercel Services binding in vercel.json —
# do not set it manually in Vercel. For local `vercel dev`, it is also injected automatically.
